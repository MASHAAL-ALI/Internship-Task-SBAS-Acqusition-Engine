`timescale 1ns/1ps
// =================================================================
// Module: if_stimulus_gen
// Description: The IF module.
//              MODIFIED FOR: PRN 5, zero Doppler (carrier fixed at
//              4.092 MHz), zero code phase (code fixed at 2.046 MHz),
//              driven by the 16.368 MHz system clock.
//
// Output: 3-bit sign-magnitude IF sample, split into
//         if_sign (1 bit) + if_mag (2 bits), concatenated into
//         L1 (3 bits).
// =================================================================
module if_stimulus_gen (
    input  wire        clk,     // 16.368 MHz system clock
    input  wire        reset,   // synchronous reset

    output wire        if_sign, // 1-bit sign
    output wire [1:0]  if_mag,  // 2-bit magnitude
    output wire [2:0]  L1       // {if_sign, if_mag} -- 3-bit sign-mag IF sample
);

    // Nominal tuning words
    localparam [31:0] CARRIER_PHASE_STEP = 32'h4000_0000; // -> 4.092 MHz
    localparam [31:0] CODE_PHASE_STEP    = 32'h2000_0000; // -> 2.046 MHz

    // =================================================================
    // 1) Carrier NCO -- inline phase accumulator + sine LUT
    // =================================================================
    reg [31:0] carrier_phase;
    always @(posedge clk) begin
        if (reset)
            carrier_phase <= 32'd0;
        else
            carrier_phase <= carrier_phase + CARRIER_PHASE_STEP;
    end

    wire [5:0] addr_q = carrier_phase[31:26];         // 64-entry LUT address
    wire [5:0] addr_i = addr_q + 6'd16;               // +90 deg for cosine

    function signed [2:0] sine_value;
        input [5:0] addr;
        begin
            case (addr)
                6'd0  : sine_value = 3'sd0;
                6'd1  : sine_value = 3'sd0;
                6'd2  : sine_value = 3'sd1;
                6'd3  : sine_value = 3'sd1;
                6'd4  : sine_value = 3'sd1;
                6'd5  : sine_value = 3'sd1;
                6'd6  : sine_value = 3'sd2;
                6'd7  : sine_value = 3'sd2;
                6'd8  : sine_value = 3'sd2;
                6'd9  : sine_value = 3'sd2;
                6'd10 : sine_value = 3'sd2;
                6'd11 : sine_value = 3'sd3;
                6'd12 : sine_value = 3'sd3;
                6'd13 : sine_value = 3'sd3;
                6'd14 : sine_value = 3'sd3;
                6'd15 : sine_value = 3'sd3;
                6'd16 : sine_value = 3'sd3;
                6'd17 : sine_value = 3'sd3;
                6'd18 : sine_value = 3'sd3;
                6'd19 : sine_value = 3'sd3;
                6'd20 : sine_value = 3'sd3;
                6'd21 : sine_value = 3'sd3;
                6'd22 : sine_value = 3'sd2;
                6'd23 : sine_value = 3'sd2;
                6'd24 : sine_value = 3'sd2;
                6'd25 : sine_value = 3'sd2;
                6'd26 : sine_value = 3'sd2;
                6'd27 : sine_value = 3'sd1;
                6'd28 : sine_value = 3'sd1;
                6'd29 : sine_value = 3'sd1;
                6'd30 : sine_value = 3'sd1;
                6'd31 : sine_value = 3'sd0;
                6'd32 : sine_value = 3'sd0;
                6'd33 : sine_value = 3'sd0;
                6'd34 : sine_value = -3'sd1;
                6'd35 : sine_value = -3'sd1;
                6'd36 : sine_value = -3'sd1;
                6'd37 : sine_value = -3'sd1;
                6'd38 : sine_value = -3'sd2;
                6'd39 : sine_value = -3'sd2;
                6'd40 : sine_value = -3'sd2;
                6'd41 : sine_value = -3'sd2;
                6'd42 : sine_value = -3'sd2;
                6'd43 : sine_value = -3'sd3;
                6'd44 : sine_value = -3'sd3;
                6'd45 : sine_value = -3'sd3;
                6'd46 : sine_value = -3'sd3;
                6'd47 : sine_value = -3'sd3;
                6'd48 : sine_value = -3'sd3;
                6'd49 : sine_value = -3'sd3;
                6'd50 : sine_value = -3'sd3;
                6'd51 : sine_value = -3'sd3;
                6'd52 : sine_value = -3'sd3;
                6'd53 : sine_value = -3'sd3;
                6'd54 : sine_value = -3'sd2;
                6'd55 : sine_value = -3'sd2;
                6'd56 : sine_value = -3'sd2;
                6'd57 : sine_value = -3'sd2;
                6'd58 : sine_value = -3'sd2;
                6'd59 : sine_value = -3'sd1;
                6'd60 : sine_value = -3'sd1;
                6'd61 : sine_value = -3'sd1;
                6'd62 : sine_value = -3'sd1;
                6'd63 : sine_value = 3'sd0;
                default: sine_value = 3'sd0;
            endcase
        end
    endfunction

    wire signed [2:0] I_ref = sine_value(addr_i);

    // =================================================================
    // 2) Code NCO -- inline phase accumulator, overflow = code_tick
    // =================================================================
    reg [31:0] code_phase;
    reg        code_tick;
    always @(posedge clk) begin
        if (reset) begin
            code_phase <= 32'd0;
            code_tick  <= 1'b0;
        end else begin
            code_phase <= code_phase + CODE_PHASE_STEP;
            if ((code_phase + CODE_PHASE_STEP) < code_phase)
                code_tick <= 1'b1;
            else
                code_tick <= 1'b0;
        end
    end

    // =================================================================
    // 3) chip_en: divide code_tick (2.046 MHz) by 2 -> 1.023 MHz
    // =================================================================
    reg tick_phase;
    always @(posedge clk) begin
        if (reset)
            tick_phase <= 1'b0;
        else if (code_tick)
            tick_phase <= ~tick_phase;
    end
    wire chip_en = code_tick & tick_phase;

    // =================================================================
    // 4) G1 / G2 Gold-code LFSRs, PRN 5 tap HARDCODED directly here
    //    Taps 3 & 7 (1-indexed) = g2[2] ^ g2[6] (0-indexed)
    // =================================================================
    reg [9:0] g1, g2;
    wire g1_fb = g1[9] ^ g1[2];
    wire g2_fb = g2[9] ^ g2[8] ^ g2[7] ^ g2[5] ^ g2[2] ^ g2[1];

    always @(posedge clk) begin
        if (reset) begin
            g1 <= 10'b1111111111;
            g2 <= 10'b1111111111;
        end else if (chip_en) begin
            g1 <= {g1[8:0], g1_fb};
            g2 <= {g2[8:0], g2_fb};
        end
    end

    wire g1_out      = g1[9];
    wire g2_selected = g2[2] ^ g2[6];        // <<< MODIFIED FOR PRN 5 HERE
    wire chip_raw    = g1_out ^ g2_selected;

    reg chip_bit;
    always @(posedge clk) begin
        if (reset)
            chip_bit <= 1'b0;
        else
            chip_bit <= chip_raw;
    end

    wire chip_negative = chip_bit;

    // =================================================================
    // 5) Sign-magnitude carrier x chip
    // =================================================================
    wire [2:0] i_ref_mag_full = I_ref[2] ? (~I_ref + 3'b001) : I_ref;
    wire       i_ref_sign     = I_ref[2];

    assign if_mag  = i_ref_mag_full[1:0];
    assign if_sign = i_ref_sign ^ chip_negative;
    assign L1      = {if_sign, if_mag};

endmodule